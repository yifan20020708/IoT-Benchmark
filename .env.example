# agent-scan — credentials & runtime env for the `claude` CLI agents.
#
# Copy to .env (gitignored):   cp .env.example .env
# Format: unquoted KEY=VALUE lines, bash-sourceable. Host-side drivers
# source it directly; task/hunt containers receive it via --env-file.
#
# Single-token policy: exactly ONE token against ONE endpoint, no
# failover/rotation proxy. (Operational hint: with some gateways an
# invalid token surfaces as HTTP 404, not 401.)

# Anthropic-compatible endpoint the claude CLI talks to
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# The one auth token for that endpoint
ANTHROPIC_AUTH_TOKEN=sk-REPLACE-ME

# One model fills every role slot (main / small-fast / haiku)
ANTHROPIC_MODEL=qwen3.8-flash
ANTHROPIC_SMALL_FAST_MODEL=qwen3.8-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.8-flash

# Optional: context budget for the CLI
CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144

PYTHONDONTWRITEBYTECODE=1
